<Window x:Class="JollyCSharpFormatter.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Jolly C# Formatter" Width="1600"	Height="950" MinWidth="1000" MinHeight="600" Foreground="#E8E8E8" Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        AllowDrop="True"	PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" />
    </WindowChrome.WindowChrome>
    
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Close" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Maximize" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Minimize" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Restore" />
    </Window.CommandBindings>
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </Window.Resources>

    <Border Margin="0,0,0,0" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="10,10,0,0" Background="#1E1E1E" >
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/CSharpFormatter.png" Width="32" Height="32" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Jolly C# Formatter" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button Content="Open" Click="Open_Click" Style="{StaticResource RoundButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Format" Click="Format_Click" Style="{StaticResource RoundButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Copy" Click="Copy_Click" Style="{StaticResource RoundButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource RoundButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Save As" Click="SaveAs_Click" Style="{StaticResource RoundButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MinimizeButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                    <Button x:Name="RestoreButton" Visibility="Collapsed" Style="{StaticResource RestoreButtonStyle}" Command="{x:Static SystemCommands.RestoreWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Restore"/>
                    <Button x:Name="MaximizeButton" Visibility="Visible" Style="{StaticResource MaximizeButtonStyle}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                </StackPanel>
            </Grid>
            
            <!-- Formatting Options -->
            <Expander Grid.Row="1" Header="Formatting Options" IsExpanded="False" Margin="0,0,0,10" Foreground="#E8E8E8">
                <Border Background="#252525" BorderBrush="#404040" BorderThickness="1" Padding="10">
                    <WrapPanel>
                        <CheckBox x:Name="SingleLineMethodDeclarationsOption" Content="Method declarations on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="SingleLineConstructorDeclarationsOption" Content="Constructor declarations on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="SingleLineMethodCallsOption" Content="Method calls on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="SingleLineConstructorCallsOption" Content="Constructor calls on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="SingleLineConditionsOption" Content="Conditions on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="SingleLineRecordDeclarationsOption" Content="Record parameters on one line" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="ExpandBlocksOption" Content="Expand single-line blocks" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="TabsOption" Content="Use tabs" IsChecked="false" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="BlankLineAfterBlocksOption" Content="Blank line after blocks" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="BlankLineAfterControlStatementsOption" Content="Blank line after unbraced control statements" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                        <CheckBox x:Name="BlankLineBetweenMembersOption" Content="Blank line between members" IsChecked="True" Margin="0,0,20,8" Foreground="#E8E8E8"/>
                    </WrapPanel>
                </Border>
            </Expander>

            <!-- Editors -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Original -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ORIGINAL" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="OriginalEditor" Grid.Row="1" TextChanged="OriginalEditor_TextChanged" Loaded="Editor_Loaded" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#404040"/>

                <!-- Reformatted -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="REFORMATTED" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="FormattedEditor" Grid.Row="1" Loaded="Editor_Loaded" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="FileNameText" Text="Drop a .cs file here" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Ready" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
